{
  "openapi": "3.0.4",
  "info": {
    "title": "BookingService API (Sap-atitos)",
    "description": "Backend API responsible for ticket purchasing, idempotency handling, and issuance (MVP-02).",
    "version": "v1-commit-cf0898eb792920a40079504d353f4bcc987cf0fa"
  },
  "paths": {
    "/test/error": {
      "get": {
        "tags": ["BookingService.Api"],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": ["BookingService.Api"],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["BookingService.Api"],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/events/{eventId}/tickets": {
      "post": {
        "tags": ["BookingService.Api"],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PurchaseTicketCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketResponse"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PurchaseTicketCommand": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "ticketId": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "TicketResponse": {
        "type": "object",
        "required": [
          "ticketId",
          "eventId",
          "seatNumber",
          "fullName",
          "email",
          "ticketCode"
        ],
        "properties": {
          "ticketId": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "seatNumber": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "ticketCode": {
            "type": "string"
          },
          "purchasedAtUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "BookingService.Api"
    }
  ]
