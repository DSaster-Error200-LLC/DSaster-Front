{
  "name": "POST /sales-module/events/{eventId}/tickets/{ticketId}/purchase",
  "priority": 7,
  "request": {
    "method": "POST",
    "urlPathTemplate": "/sales-module/events/{eventId}/tickets/{ticketId}/purchase",
    "pathParameters": {
      "eventId": {
        "matches": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
      },
      "ticketId": {
        "matches": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
      }
    }
  },
  "response": {
    "status": 200,
    "bodyFileName": "sales-module/purchase-ticket-success.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
